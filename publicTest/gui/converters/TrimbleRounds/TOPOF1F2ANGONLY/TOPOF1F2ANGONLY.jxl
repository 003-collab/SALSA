                    <Attribute>
                        <Name>Photo</Name>
                        <Value/>
                        <Type>Photo</Type>
                    </Attribute>
                    <Attribute>
                        <Name>Look Direction</Name>
                        <Value>NW</Value>
                        <Type>Text</Type>
                    </Attribute>
                    <Attribute>
                        <Name>Field Notes</Name>
                        <Value>TOP POLE</Value>
                        <Type>Text</Type>
                    </Attribute>
                    <Attribute>
                        <Name>Height Above Ground</Name>
                        <Value>NA</Value>
                        <Type>Text</Type>
                    </Attribute>
                    <Attribute>
                        <Name>HI (meters)</Name>
                        <Value>0.0</Value>
                        <Type>Text</Type>
                    </Attribute>
                    <Attribute>
                        <Name>HI (feet)</Name>
                        <Value/>
                        <Type>Text</Type>
                    </Attribute>
                    <Attribute>
                        <Name>HI Measured To</Name>
                        <Value>TOP</Value>
                        <Type>Text</Type>
                    </Attribute>
                </Feature>
            </Features>

            <Grid>
                <North/>
                <East/>
                <Elevation/>
            </Grid>
        </Point>
    </Reductions>

    <Environment>

        <DisplaySettings>
            <DistanceUnits>Metres</DistanceUnits>
            <HeightUnits>Metres</HeightUnits>
            <AngleUnits>DMSDegrees</AngleUnits>
            <AzimuthFormat>Azimuth</AzimuthFormat>
            <LatitudeLongitudeUnits>DMSDegrees</LatitudeLongitudeUnits>
            <CoordinateOrder>North-East-Elevation</CoordinateOrder>
            <TemperatureUnits>Celsius</TemperatureUnits>
            <PressureUnits>MilliBar</PressureUnits>
            <GradeUnits>Percentage</GradeUnits>
            <AreaUnits>SquareMetres</AreaUnits>
            <VolumeUnits>CubicMetres</VolumeUnits>
            <StationingFormat>1+000.0</StationingFormat>
            <StationIndexIncrement/>
            <DistanceDisplayDPs>3</DistanceDisplayDPs>
            <CoordinateDisplayDPs>3</CoordinateDisplayDPs>
            <AreaDisplayDPs>3</AreaDisplayDPs>
            <VolumeDisplayDPs>3</VolumeDisplayDPs>
            <AngleDisplayDPs>0</AngleDisplayDPs>
            <LaserVADisplay>Inclination</LaserVADisplay>
            <TimeFormat>Local</TimeFormat>
        </DisplaySettings>

        <CoordinateSystem>
            <SystemName/>
            <ZoneName/>
            <DatumName/>
            <Ellipsoid>
                <EarthRadius/>
                <Flattening/>
            </Ellipsoid>
            <Projection>
                <Type>ScaleOnly</Type>
                <Scale>1</Scale>
                <SouthAzimuth>false</SouthAzimuth>
                <GridOrientation>IncreasingNorthEast</GridOrientation>
                <ApplySeaLevelCorrection>false</ApplySeaLevelCorrection>
                <MagneticDeclination>0</MagneticDeclination>
                <Distances>GroundDistance</Distances>
            </Projection>
            <LocalSite>
                <Type>Grid</Type>
                <ProjectLocationLatitude/>
                <ProjectLocationLongitude/>
                <ProjectLocationHeight/>
            </LocalSite>
            <Datum>
                <Type>NoDatum</Type>
            </Datum>
            <HorizontalAdjustment>
                <Type>NoAdjustment</Type>
            </HorizontalAdjustment>
            <VerticalAdjustment>
                <Type>NoAdjustment</Type>
            </VerticalAdjustment>
            <CombinedScaleFactor>
                <Location>
                    <Latitude/>
                    <Longitude/>
                    <Height/>
                </Location>
                <Scale>1</Scale>
            </CombinedScaleFactor>
            <TectonicPlate>
                <Name>Unknown</Name>
            </TectonicPlate>
        </CoordinateSystem>

        <JobProperties>
            <Reference/>
            <Description/>
            <Operator/>
            <JobNote/>
            <TectonicPlate>Unknown</TectonicPlate>
            <ApplyJobPointNameRange>false</ApplyJobPointNameRange>
            <MinimumJobPointName/>
            <MaximumJobPointName/>
        </JobProperties>

        <JobSettings>
            <NeighbourhoodAdjustment>
                <Applied>false</Applied>
                <WeightExponent>0.5</WeightExponent>
            </NeighbourhoodAdjustment>
            <Averaging>Weighted</Averaging>
            <UseAttributesOfBaseCode>true</UseAttributesOfBaseCode>
        </JobSettings>

        <AssociatedFiles>
            <LinkedFiles/>
            <ActiveMapFiles/>
            <FeatureCodeLibrary>NGAv2.fxl</FeatureCodeLibrary>
            <ExportedFiles/>
            <DefinitionFiles/>
        </AssociatedFiles>

        <TimeZone>
            <ZoneName>Pacific Daylight Time</ZoneName>
            <HoursToUTC>7</HoursToUTC>
        </TimeZone>
    </Environment>
</JOBFile>
