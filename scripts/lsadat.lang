<language id="lsadat" _name="lsadat" version="2.0" _section="Sources">
    <metadata>
      <property name="mimetypes">text/x-lsa;text/x-dat;text/x-out</property>
      <property name="globs">*.lsa;*.proj</property>
      <property name="line-comment-start">#</property>
    </metadata>

    <styles>
        <style id="comment" _name="Comment" map-to="def:comment"/>
        <style id="keyword" _name="Keyword" map-to="def:keyword"/>
        <style id="type" _name="Data Type" map-to="def:type"/>
    </styles>

    <definitions>
        <context id="lsadat">
            <include>
                <context id="line-comment" style-ref="comment" end-at-line-end="true" class="comment" class-disabled="no-spell-check">
                    <start>#</start>
                </context>

                <context id="keywords" style-ref="keyword">
                    <keyword>PLOH</keyword>
                </context>

                <context id="types" style-ref="type">
	            <keyword>include</keyword>
                <keyword>POSG</keyword>
                <keyword>POSC</keyword>
                <keyword>DXYZ</keyword>
                <keyword>DIST</keyword>
                <keyword>HANG</keyword>
                <keyword>ZANG</keyword>
                <keyword>VANG</keyword>
                <keyword>AZIM</keyword>
                <keyword>HDIF</keyword>
                <keyword>DGRP</keyword>
                <keyword>HDIR</keyword>
                <keyword>UNCR</keyword>
                <keyword>VSCA</keyword>
                <keyword>HGHT</keyword>

                <keyword>HFROM</keyword>
                <keyword>HTO</keyword>
                <keyword>UNCR</keyword>
                <keyword>REFRACT</keyword>
                <keyword>REDUCED</keyword>
                <keyword>VSCA</keyword>
                <keyword>CURV</keyword>
                <keyword>CONV</keyword>
                <keyword>AUTOGEN</keyword>
                <keyword>TOPARENT</keyword>
                <keyword>EXTR</keyword>
                <keyword>MEAN</keyword>
                <keyword>DENU</keyword>

                </context>

            </include>
        </context>
    </definitions>
</language>
